# Grafana Cloud instance the dashboards are pushed to, and a service account
# token with dashboard write scope. Both are REQUIRED by the two push scripts —
# neither has a default any more.
GRAFANA_URL=https://your-org.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Slack channel id for the run-started / run-finished bookends.
# Leave unset to run without any Slack posting.
SLACK_CHANNEL_ID=

# Chrome profile the scraper drives. Defaults to the macOS ms-playwright cache
# (~/Library/Caches/ms-playwright/mcp-chrome-linkedin-stats); set this on Linux or
# when pointing the run at a sandbox profile.
# LI_CHROME_PROFILE_DIR=

# --- Browserbase backend (LI_BACKEND=browserbase, the default in run-weekly.sh)
# The scraper drives a REMOTE browser, so these two are REQUIRED for any weekly
# run; run-weekly.sh now refuses to start without them. Locally they live in
# scripts/lifleet/.env (source it, or copy them here); in CI they are Actions
# secrets of the SAME two names. See .claude/skills/linkedin-stats/WEEKLY-CADENCE.md.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Path to the lifleet registry that maps author slug -> Browserbase context_id.
# The default is scripts/lifleet/authors.json, which is GITIGNORED — a fresh
# checkout has none, so CI materialises it from the LIFLEET_AUTHORS_JSON secret
# outside the working tree and points this at that file. LIFLEET_REGISTRY is
# accepted as an alias (that is the name scripts/lifleet/.env uses).
# LIFLEET_AUTHORS=

# Optional: `off` skips the proxy request that 402s on the free Browserbase plan.
# LIFLEET_PROXIES=on
