# Ключі Browserbase: дашборд browserbase.com -> Settings -> API Keys
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Де лежить реєстр авторів (дефолт ./authors.json)
LIFLEET_REGISTRY=./authors.json

# Дефолтний регіон Browserbase для нових авторів
LIFLEET_REGION=eu-central-1

# Скільки секунд живе щоденна робоча сесія author_page (дефолт 900 = 15 хв)
LIFLEET_SESSION_TIMEOUT=900

# Проксі з геолокацією країни автора: on (дефолт) або off.
# Free plan Browserbase проксі не має — lifleet сам це помітить (402)
# і продовжить без них; off просто прибирає зайву спробу і попередження.
LIFLEET_PROXIES=on
