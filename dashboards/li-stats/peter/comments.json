    "urn:li:comment:(activity:7492474869096472576,7493085128018071552)": {
      "comment_urn": "urn:li:comment:(activity:7492474869096472576,7493085128018071552)",
      "commented_at": "2026-08-11T23:25:09Z",
      "verb": "commented",
      "text": "Not long ago, teams were assessed by more code, more PRs, and faster delivery (see DORA metrics). Now it feels more obvious that the hard part is still human: understanding what should be built, checking if it works, and seeing if it helps users. Maybe the next useful metrics will be closer to product requirement mistakes, rework, and end-user feedback.",
      "comment_author_name": "Peter Ovchynnikov",
      "comment_author_url": "https://www.linkedin.com/in/ovchyn",
      "post_urn": "urn:li:activity:7493085154949709824",
      "post_url": "https://www.linkedin.com/feed/update/urn:li:activity:7493085154949709824/",
