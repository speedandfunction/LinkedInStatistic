    "urn:li:comment:(activity:7453431620012867585,7454941946923454464)": {
      "comment_urn": "urn:li:comment:(activity:7453431620012867585,7454941946923454464)",
      "commented_at": "2026-04-28T17:17:46Z",
      "verb": "commented",
      "text": "Just copy their business model and build a reliable human support. And you're the king 👑",
      "comment_author_name": "Andrii Rozhylo",
      "comment_author_url": "https://www.linkedin.com/in/arozhylo",
      "post_urn": "urn:li:activity:7454941965206487041",
      "post_url": "https://www.linkedin.com/feed/update/urn:li:activity:7454941965206487041/",
      "post_author_name": "Mark Hutchins",
      "post_author_url": "https://www.linkedin.com/in/mark-hutchins",
      "permalink": "https://www.linkedin.com/feed/update/urn:li:activity:7454941965206487041/?commentUrn=urn%3Ali%3Acomment%3A%28activity%3A7453431620012867585%2C7454941946923454464%29",
