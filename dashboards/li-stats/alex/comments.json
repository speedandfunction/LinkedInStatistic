    "urn:li:comment:(activity:7454892308568764417,7454938865611575296)": {
      "comment_urn": "urn:li:comment:(activity:7454892308568764417,7454938865611575296)",
      "commented_at": "2026-04-28T17:05:31Z",
      "verb": "commented",
      "text": "Anthropic is building powerful infrastructure that reshapes how companies operate — embedding itself into core business processes and creating dependency. That naturally raises expectations around reliability, data safety, and stability.\n\nRight now, Anthropic doesn’t fully meet that bar, and repeated issues are already affecting trust.\n\nThis will likely push companies toward more local, vendor-independent setups - not for performance, but to regain control and reduce reliance on a single provider.",
      "comment_author_name": "Andrii Rozhylo",
      "comment_author_url": "https://www.linkedin.com/in/arozhylo",
      "post_urn": "urn:li:activity:7455153632599064578",
      "post_url": "https://www.linkedin.com/feed/update/urn:li:activity:7455153632599064578/",
      "post_author_name": "Nick Gluzdov",
      "post_author_url": "https://www.linkedin.com/in/gluzd",
      "permalink": "https://www.linkedin.com/feed/update/urn:li:activity:7455153632599064578/?commentUrn=urn%3Ali%3Acomment%3A%28activity%3A7454892308568764417%2C7454938865611575296%29",
      "weeks": {}
    },
